      "border": {
        "width": 1,
        "color": "$line",
        "style": "solid"
      },
      "radius": "$radius",
      "padding": {
        "top": 6,
        "end": 12,
        "bottom": 6,
        "start": 12
      },
      "text": {
        "color": "$text-dim",
        "size": 13.6
      }
    },
    ".hud-objective-compact": {
      "padding": {
